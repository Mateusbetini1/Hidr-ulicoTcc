        "name": "Consultar solicitações no Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [500, 300]
      },
      {
        "parameters": {
          "jsCode": "// A função do Supabase retorna todas as solicitações permitidas ao painel.\n// Aqui mantemos apenas as que ainda estão no início do atendimento.\nconst solicitacoes = $input.all().flatMap((item) => {\n  return Array.isArray(item.json) ? item.json : [item.json];\n});\n\nreturn solicitacoes\n  .filter((solicitacao) => solicitacao.status === 'novo')\n  .map((solicitacao) => ({\n    json: {\n      id: solicitacao.id,\n      cliente: solicitacao.cliente_nome,\n      empresa: solicitacao.empresa,\n      whatsapp: solicitacao.whatsapp,\n      descricao: solicitacao.descricao,\n      recebido_em: solicitacao.criado_em,\n    },\n  }));"
        },
        "id": "a1e6d86d-6df3-4686-85cd-7ba62de8e6d0",
        "name": "Selecionar novas solicitações",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [780, 300]
      },
      {
        "parameters": {
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "method": "POST",
          "url": "https://api.resend.com/emails",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ from: 'WG Hidráulica <onboarding@resend.dev>', to: ['mateus.betini@hotmail.com'], subject: 'Nova solicitação — ' + ($json.empresa || $json.cliente), text: 'Uma nova solicitação de orçamento foi recebida pela WG Hidráulica.\\n\\nCliente: ' + $json.cliente + '\\nEmpresa: ' + ($json.empresa || 'Não informada') + '\\nWhatsApp: ' + $json.whatsapp + '\\nNecessidade: ' + $json.descricao + '\\nRecebida em: ' + $json.recebido_em + '\\n\\nAcesse o painel comercial para continuar o atendimento.' }) }}",
          "options": {}
        },
        "id": "cc67f235-e2bc-42cb-b370-6876d88cafec",
        "name": "Notificar equipe por e-mail",
