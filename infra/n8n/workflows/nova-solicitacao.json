        "name": "Verificar a cada 5 minutos",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [260, 120]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/reservar_notificacoes_solicitacao' }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "={{ $env.SUPABASE_PUBLISHABLE_KEY }}"
              },
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $env.SUPABASE_PUBLISHABLE_KEY }}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ p_chave: $env.SUPABASE_DASHBOARD_SECRET, p_remetente: $env.WG_NOTIFICACAO_REMETENTE || null, p_destinatario: $env.WG_NOTIFICACAO_DESTINATARIO || null }) }}",
          "options": {
            "timeout": 15000
          }
        },
        "id": "ba4a8ea0-a6b1-4fd7-805d-c882486a6abd",
        "name": "Reservar notificações no Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [500, 300]
      },
      {
        "parameters": {
          "jsCode": "const { notificacoes } = $input.first().json;\nif (!Array.isArray(notificacoes)) throw new Error('Resposta inválida da fila de notificações');\nreturn notificacoes.map(notificacao => ({ json: notificacao, pairedItem: { item: 0 } }));"
        },
        "id": "a1e6d86d-6df3-4686-85cd-7ba62de8e6d0",
        "name": "Expandir reservas",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [780, 300]
      },
      {
        "parameters": {
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "method": "POST",
          "url": "https://api.resend.com/emails",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Idempotency-Key",
                "value": "={{ $json.chave_idempotencia }}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ (() => {\n  const limite = Date.parse($json.reservada_ate);\n  if (!(limite - Date.now() > 30000)) throw new Error('Reserva insuficiente para enviar');\n  return JSON.stringify($json.payload);\n})() }}",
          "options": {
            "timeout": 20000,
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true,
                "responseFormat": "json"
              }
            }
          }
        },
        "id": "cc67f235-e2bc-42cb-b370-6876d88cafec",
        "name": "Notificar equipe por e-mail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [1040, 300],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const reserva = $('Expandir reservas').item.json;\nconst { statusCode, body } = $json;\nconst http = Number(statusCode);\nlet resultado = 'incerto';\nlet resendId = null;\nif (http >= 200 && http < 300 && typeof body?.id === 'string' && body.id.trim() && body.id.length <= 128) {\n  resultado = 'aceito';\n  resendId = body.id;\n} else if (http === 429) {\n  resultado = 'repetir';\n} else if ([400, 401, 403, 404, 405, 413, 422].includes(http)) {\n  resultado = 'rejeitado';\n}\nreturn { json: {\n  solicitacao_id: reserva.solicitacao_id,\n  reserva: reserva.reserva,\n  resultado,\n  resend_id: resendId,\n  erro: resultado === 'aceito' ? null : (Number.isInteger(http) && http >= 100 ? 'HTTP ' + http : 'resposta_indisponivel'),\n} };"
        },
        "id": "cf6711e2-44ab-4c1a-a1d8-2e47deea9094",
        "name": "Classificar resultado do envio",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1270, 300]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/finalizar_notificacao_solicitacao' }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "={{ $env.SUPABASE_PUBLISHABLE_KEY }}"
              },
