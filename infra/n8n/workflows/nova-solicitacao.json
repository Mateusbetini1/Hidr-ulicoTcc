                "value": "={{ 'Bearer ' + $env.SUPABASE_PUBLISHABLE_KEY }}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ p_chave: $env.SUPABASE_DASHBOARD_SECRET, p_solicitacao_id: $json.solicitacao_id, p_reserva: $json.reserva, p_resultado: $json.resultado, p_resend_id: $json.resend_id, p_erro: $json.erro }) }}",
          "options": {
            "timeout": 15000
          }
        },
        "id": "859e0d5d-8db0-4532-a9cc-3293a9eac6df",
        "name": "Registrar resultado no Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [1520, 300]
      }
